# ===========================================================================
# Frontend environment configuration — copy to `.env.local` and adjust.
#
#   cp frontend/.env.example frontend/.env.local
#
# Only NEXT_PUBLIC_* values reach the browser. Never put the Supabase service
# role key or the JWT signing key in this file.
# ===========================================================================

# Base URL of the ASP.NET Core Web API.
# Server-side calls (route handlers, `proxy.ts`) use this.
API_BASE_URL=http://localhost:5062

# Same value, exposed to the browser for client-side fetches.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5062
