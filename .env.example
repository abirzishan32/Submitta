# ===========================================================================
# Docker Compose overrides — OPTIONAL.
#
#   cp .env.example .env
#
# `docker compose up` works with no .env at all; every value below has a
# working default. Copy this file only to change a published port, or to run
# the stack in Production mode.
#
# `.env` is git-ignored. Never commit real credentials.
#
# This file configures the CONTAINERS. Running the backend directly with
# `dotnet run` instead reads backend/.env — see backend/.env.example.
# ===========================================================================

# ---------------------------------------------------------------------------
# Published ports — change any that clash with something already running.
# ---------------------------------------------------------------------------
# WEB_PORT=3000
# API_PORT=5062
# DB_PORT=5433

# ---------------------------------------------------------------------------
# Database password for the `db` container.
#
# The default is a throwaway value for a database reachable only from inside
# the compose network. Set a real one here for anything else.
# ---------------------------------------------------------------------------
# POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Production mode.
#
# The stack defaults to Development, which publishes Swagger and uses the
# development signing key committed in appsettings.Development.json.
#
# Setting Production turns Swagger off and makes Jwt__Key mandatory — the API
# refuses to start without it. Uncomment BOTH lines together, or the container
# will exit at startup.
#
# Generate a key with:
#   openssl rand -base64 48
#
# Changing it invalidates every issued token, signing everyone out.
# ---------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT=Production
# Jwt__Key=

# ---------------------------------------------------------------------------
# Demo seed data.
#
# The API seeds the demo accounts on first start, using the password in
# appsettings.json. Override it, or switch seeding off entirely, here.
# ---------------------------------------------------------------------------
# Seed__Enabled=false
# Seed__DefaultPassword=
