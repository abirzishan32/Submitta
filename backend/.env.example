# ===========================================================================
# Backend environment configuration — copy to `.env` and fill in real values.
#
#   cp backend/.env.example backend/.env
#
# `.env` is git-ignored. Never commit real credentials.
# ===========================================================================

# ---------------------------------------------------------------------------
# DATABASE — required.
#
# Any PostgreSQL 14 or newer. Nothing in the application is provider-specific:
# the schema, migrations and seed data are plain PostgreSQL.
#
# Both connection-string forms are accepted:
#   postgresql://user:password@host:5432/database
#   Host=host;Port=5432;Database=name;Username=user;Password=secret
#
# TLS is chosen from the host — disabled for localhost, required for anything
# remote. Append ?sslmode=... to override.
#
# You only need an EMPTY database. The application creates every table itself
# on first run and seeds the demo data; there is nothing to create by hand.
#
#   createdb assignment_system
# ---------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=CHANGE_ME

# --- A hosted database instead (Supabase, Neon, RDS, …) ---------------------
#
# Use the DIRECT PostgreSQL connection string, not a REST API URL or an API key.
# In Supabase: Project Settings -> Database -> Connection string -> URI, and
# prefer the session pooler on port 5432. The transaction pooler on 6543 does
# not support the prepared statements EF Core migrations rely on.
#
# ConnectionStrings__DefaultConnection=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---------------------------------------------------------------------------
# JWT — authentication is implemented in this API, not delegated to a provider.
#
# OPTIONAL for local development: appsettings.Development.json ships a
# development-only signing key, so sign-in works immediately after checkout.
# The application refuses to start outside Development without a key set here.
#
# Generate one with:
#   openssl rand -base64 48
#
# Changing it invalidates every issued token, signing everyone out.
# ---------------------------------------------------------------------------
# Jwt__Key=<a-random-string-of-at-least-32-characters>
# Jwt__Issuer=AssignmentSystem.Api
# Jwt__Audience=AssignmentSystem.Client
# Jwt__AccessTokenMinutes=15
# Jwt__RefreshTokenDays=7

# ---------------------------------------------------------------------------
# CORS — the origin the Next.js frontend is served from.
# ---------------------------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:3000

# ---------------------------------------------------------------------------
# SEEDING — optional.
#
# appsettings.json carries the demo password, so a fresh clone runs with no
# extra setup. Override it here, or set Seed__Enabled=false, for a real
# deployment. The seeder is idempotent and safe to leave on.
# ---------------------------------------------------------------------------
# Seed__Enabled=true
# Seed__DefaultPassword=<choose-a-demo-password>
