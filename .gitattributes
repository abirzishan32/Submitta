# Normalize line endings so the repo is consistent across Windows/macOS/Linux.
* text=auto eol=lf

*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf
*.ts        text
*.tsx       text
*.json      text
*.css       text
*.md        text

*.png       binary
*.jpg       binary
*.ico       binary
*.svg       text
